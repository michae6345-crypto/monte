{
  "manifest_version": 3,
  "name": "Monte: the right card at checkout",
  "short_name": "Monte",
  "version": "0.2.0",
  "description": "On any store's site, Monte names the card to pay with: the one that earns the most there, unless a balance means it would cost you more in interest.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Which card here?",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://ace-eta-beryl.vercel.app/*", "http://localhost:3011/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://ace-eta-beryl.vercel.app/*", "http://localhost:3011/*"],
      "js": ["sync.js"],
      "run_at": "document_idle"
    }
  ]
}
