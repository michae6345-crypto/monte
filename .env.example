# Copy to .env.local for local dev; set the same vars on Vercel or Render (docs/deploy.md).
# This file holds NO secret values - the repo is public. Every var is optional: with
# none set, the app builds and runs on the demo people.
#
# NEXT_PUBLIC_* vars are baked in at build time. Change one, then redeploy.

# --- Plaid (sandbox). Unset: every /api/plaid/* route answers 503 {"error":"plaid_not_configured"}.
# From the Plaid dashboard (free sandbox account): https://dashboard.plaid.com/developers/keys

# Plaid client_id (not a secret, but keep it out of the repo anyway)
PLAID_CLIENT_ID=

# Plaid sandbox secret. NEVER commit a real value, and never use a production secret:
# this app stores the Plaid access_token in a cookie, which is a sandbox-only shortcut.
PLAID_SECRET=

# "sandbox" (default if unset) or "production". /api/plaid/sandbox only works in sandbox.
PLAID_ENV=sandbox

# --- Supabase (saves cap state per signed-in user; the app falls back to demo people without it)
# Project URL and publishable key are public by design (row-level security guards the data).
NEXT_PUBLIC_SUPABASE_URL=https://cgdjemhpgjkmxsgljxgs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_f9QwrWFE1zUSVONNKgwing_4mRdzwyg
SUPABASE_SECRET_KEY=            # server only, never NEXT_PUBLIC_, never committed

# --- Anthropic (merchant-name cleanup and the checkout agent's words; never the pricing path)
# Unset: /api/paypal/agent answers 503 {"error":"agent_not_configured"}; categorize falls back to rules.
ANTHROPIC_API_KEY=

# --- PayPal (sandbox only). Without these, every /api/paypal/* route answers
# 503 {"error":"paypal_not_configured"} and the app still runs.
# From a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
# NEXT_PUBLIC_PAYPAL_CLIENT_ID is read at build time, so redeploy after setting it.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Anything other than "sandbox" counts as not configured.
PAYPAL_ENV=sandbox
# Webhook ID for /api/paypal/webhook (refunds and captures made outside the page). Get it from
# developer.paypal.com -> Apps & Credentials -> your sandbox app -> Webhooks -> Add webhook,
# URL https://<site>/api/paypal/webhook, events PAYMENT.CAPTURE.COMPLETED and
# PAYMENT.CAPTURE.REFUNDED; copy the Webhook ID it shows. Unset: the webhook route answers 503.
PAYPAL_WEBHOOK_ID=
# "1" shows Venmo and Pay Later buttons next to the PayPal button. Off (unset) for the demo.
# Build-time var: redeploy after changing it.
NEXT_PUBLIC_PAYPAL_EXTRA_FUNDING=
