# Copy to .env.local for local dev; set the same three in Render (dashboard or the API,
# see docs/deploy.md). This file holds NO real values - the repo is public.
#
# With these unset the app still builds and still runs on the personas, and every
# /api/plaid/* route answers 503 {"error":"plaid_not_configured"}.
#
# Get them from the Plaid dashboard (free sandbox account):
#   https://dashboard.plaid.com/developers/keys

# Plaid client_id (not a secret, but keep it out of the repo anyway)
PLAID_CLIENT_ID=

# Plaid sandbox secret. NEVER commit a real value, and never use a production secret:
# this app stores the Plaid access_token in a cookie, which is a sandbox-only shortcut.
PLAID_SECRET=

# "sandbox" (default if unset) or "production". /api/plaid/sandbox only works in sandbox.
PLAID_ENV=sandbox
