{
  "enabledMcpjsonServers": [
    "hivemind"
  ],
  "statusLine": {
    "type": "command",
    "command": "hivemind statusline",
    "padding": 0
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "hivemind hook claude-code",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hivemind hook claude-code UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "hivemind hook claude-code PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hivemind hook claude-code SessionEnd",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
